# Projeto Supabase deste módulo (Ecossistema Frota x Suprimentos).
# Rode as migrations de supabase/migrations/ nele antes do primeiro uso.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Usada só em código server-only. Necessária pra página pública de
# orçamento (/orcamento/[token]) — o fornecedor acessa sem login, então
# essa rota ignora RLS via service role e usa o token como única
# autorização (ver lib/frota/orcamento-publico.ts).
SUPABASE_SERVICE_ROLE_KEY=

# URL pública deste app — usada em links/redirects e para montar o link de
# orçamento copiado pelo Suprimentos (ex.: https://seu-dominio/orcamento/<token>).
# Sem essa variável, o link fica sem domínio.
NEXT_PUBLIC_APP_URL=http://localhost:3000
